# Copy to .env  (never commit .env — it holds live router tokens and an app password)
#   cp .env.example .env
#
# Every value below is blank on purpose: this file is the shape of the config, not a working one.
# Anything left blank falls back to the default in config.py, where one exists.

# ---------- Claude Code CLI engine (ai_engine.py) ----------
# Generation runs through the official `claude` CLI in a hidden subprocess, not the Python SDK:
# the router fingerprints HTTP clients and 401s the SDK, while it accepts the CLI. The CLI reads
# these two variables itself — ai_engine passes the whole environment into the subprocess.
ANTHROPIC_BASE_URL=
# The model chain, primary then fallback, retried automatically. Passed as `claude --model`.
ANTHROPIC_MODEL=
# Round-robin pool, injected as ANTHROPIC_AUTH_TOKEN for each attempt. Fill 1..3; blanks are dropped.
# Rotation happens on failure, then the whole pool is re-swept against the fallback model.
# Leave all three empty to use whatever the CLI is already logged into (`claude` OAuth login).
ROUTER_AUTH_TOKEN_1=
ROUTER_AUTH_TOKEN_2=
ROUTER_AUTH_TOKEN_3=
# Single-token fallback, used only when every ROUTER_AUTH_TOKEN_* is empty.
ANTHROPIC_AUTH_TOKEN=
# Full path to claude.exe if it is not on PATH, and the per-call kill deadline in seconds.
# A real call takes ~40s; the timeout only fires on a stuck process.
CLAUDE_CLI=
CLI_TIMEOUT=300

# ---------- Resume contact block ----------
# Blank values are omitted from the PDF. Nothing here is ever invented by the model.
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LOCATION=
CANDIDATE_GITHUB=
CANDIDATE_LINKEDIN=

# ---------- HR discovery ----------
# Optional. Without it, cold email falls back to an hr_email already stored on the job row.
HUNTER_API_KEY=

# ---------- Gmail SMTP + IMAP ----------
# SMTP_PASSWORD must be a Google App Password (16 chars), not the account password.
# Port 587 = STARTTLS, port 465 = implicit SSL. Both supported.
# Leaving SMTP_HOST blank falls back to the Gmail default in config.py; any other provider goes here.
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
# Reply polling reads the same mailbox, and the Sent folder is what proves a mail really left.
IMAP_HOST=
IMAP_PORT=993
SENT_MAILBOX=

# ---------- GitHub (the daily project pushes a repo per build) ----------
# GITHUB_TOKEN is a Personal Access Token with the `repo` scope. A GitHub PASSWORD does not work
# here and has not since 2021 — the REST API refuses password authentication outright.
GITHUB_USER=
GITHUB_TOKEN=

# ---------- Runtime ----------
# 1 = walk the entire code path but skip real submits and real emails. Flip to 0 when confident.
DRY_RUN=1
# 0 = visible browser window. Logged-in platform flows are far more reliable headed.
HEADLESS=0
# 1 = a run may stop and ask a human (dashboard button, or ENTER on the console). 0 = never ask.
HITL=1
# Per search-term x location query, so 20 x 3 terms x 3 locations is the upper bound per scrape.
RESULTS_PER_QUERY=20
SCRAPE_HOURS_OLD=72
